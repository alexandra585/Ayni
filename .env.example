# ── Modo de la app ─────────────────────────────────────────────
# demo     → todo vive en memoria (paridad con el prototipo HTML). No requiere Supabase.
# supabase → Auth + Postgres reales; pagos XLM en Stellar Testnet.
NEXT_PUBLIC_AYNI_MODE=demo

# ── Supabase (solo modo supabase) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Jamás NEXT_PUBLIC_*. Se usa para verificar/registrar pagos con el ledger.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stellar Testnet (MVP TESTNET ONLY) ─────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Cuenta treasury de demo (dirección pública; la reciben los pagos de cuotas).
NEXT_PUBLIC_STELLAR_TREASURY_PUBLIC=
# SOLO servidor. Secret de la cuenta treasury (testnet). Jamás NEXT_PUBLIC_*.
STELLAR_TREASURY_SECRET=
